<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="850.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ManageAidController">
    <top>
        <fx:include source="MenuBar.fxml" />
    </top>
    <left>
        <VBox prefWidth="260.0" spacing="12.0" style="-fx-background-color: white;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleBackToDashboard" style="-fx-background-color: #34495e;" text="&lt; Back to Dashboard">
                    <VBox.margin><Insets bottom="10.0" /></VBox.margin>
                </Button>
                <Label text="Distribute Aid" textFill="#2c3e50">
                    <font><Font name="System Bold" size="18.0" /></font>
                </Label>

                <ComboBox fx:id="cmbFilter" maxWidth="1.7976931348623157E308" onAction="#handleFilterChange" promptText="🔍 Filter Families..." style="-fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-radius: 3;" />

                <ComboBox fx:id="cmbFamily" maxWidth="1.7976931348623157E308" promptText="Select Family *" />
                <ComboBox fx:id="cmbAidType" maxWidth="1.7976931348623157E308" promptText="Aid Type *" />
                <TextField fx:id="txtQuantity" promptText="Quantity (Numbers only) *" />
                <HBox spacing="10.0">
                    <children>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleDistribute" style="-fx-background-color: #27ae60;" text="Distribute Aid" HBox.hgrow="ALWAYS" />
                    </children>
                    <VBox.margin><Insets top="10.0" /></VBox.margin>
                </HBox>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleReset" style="-fx-background-color: #7f8c8d;" text="Reset Fields" />
            </children>
        </VBox>
    </left>
    <center>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <TableView fx:id="tableAid" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="50.0" text="Aid ID" />
                        <TableColumn fx:id="colFamily" prefWidth="180.0" text="Family Name" />
                        <TableColumn fx:id="colType" prefWidth="120.0" text="Aid Type" />
                        <TableColumn fx:id="colQuantity" prefWidth="90.0" text="Quantity" />
                        <TableColumn fx:id="colDate" prefWidth="140.0" text="Distribution Date" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>