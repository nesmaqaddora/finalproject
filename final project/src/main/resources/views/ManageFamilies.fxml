<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="850.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ManageFamiliesController">
    <top>
        <fx:include source="MenuBar.fxml" />
    </top>
    <left>
        <VBox prefWidth="260.0" spacing="10.0" style="-fx-background-color: white;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleBackToDashboard" style="-fx-background-color: #34495e;" text="&lt; Back to Dashboard">
                    <VBox.margin><Insets bottom="10.0" /></VBox.margin>
                </Button>
                <Label text="Family Info" textFill="#2c3e50">
                    <font><Font name="System Bold" size="18.0" /></font>
                </Label>
                <TextField fx:id="txtNationalId" promptText="National ID *" />
                <TextField fx:id="txtHeadName" promptText="Head of Household Name *" />
                <TextField fx:id="txtPhone" promptText="Phone Number *" />
                <TextField fx:id="txtMembersCount" promptText="Number of Members *" />
                <ComboBox fx:id="cmbVulnerability" maxWidth="1.7976931348623157E308" promptText="Vulnerability Level *" />
                <TextField fx:id="txtAddress" promptText="Address / Location *" />
                <HBox spacing="10.0">
                    <children>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleAdd" style="-fx-background-color: #27ae60;" text="Add" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleUpdate" style="-fx-background-color: #f39c12;" text="Update" HBox.hgrow="ALWAYS" />
                    </children>
                    <VBox.margin><Insets top="10.0" /></VBox.margin>
                </HBox>
                <HBox spacing="10.0">
                    <children>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleDelete" style="-fx-background-color: #e74c3c;" text="Delete" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleReset" style="-fx-background-color: #7f8c8d;" text="Reset" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </left>
    <center>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <TableView fx:id="tableFamilies" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="40.0" text="ID" />
                        <TableColumn fx:id="colNationalId" prefWidth="90.0" text="National ID" />
                        <TableColumn fx:id="colName" prefWidth="120.0" text="Head Name" />
                        <TableColumn fx:id="colPhone" prefWidth="90.0" text="Phone" />
                        <TableColumn fx:id="colMembers" prefWidth="70.0" text="Members" />
                        <TableColumn fx:id="colVulnerability" prefWidth="90.0" text="Vulnerability" />
                        <TableColumn fx:id="colAddress" prefWidth="100.0" text="Location" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>